  "recorded": {
   "paper": {
    "title": "Prompt-Based Abstention Fails Under Misleading Context: A Controlled Study of Small Frozen RAG Models",
    "authors": [
     "Yohanes Andre Setiawan"
    ],
    "year": 2026,
    "arxiv": "2608.22228",
    "url": "https://arxiv.org/abs/2608.22228",
    "abstract": "Missing and misleading evidence are not the same problem in retrieval-augmented generation (RAG), but prompt-based abstention treats them alike. Models abstain when context is absent, not when it is misleading. We introduce GRAB-RAG (Graded Abstention Benchmark for Retrieval-Augmented Generation), a paired benchmark that tests the same questions across four context conditions (supportive, degraded, missing, and misleading) in Natural Questions and HotpotQA. In the misleading condition, we edit a…",
    "source": "arxiv"
   }
